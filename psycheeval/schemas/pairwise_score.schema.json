        "$ref": "#/$defs/RedFlag"
      },
      "title": "Red Flags A",
      "type": "array"
    },
    "red_flags_B": {
      "items": {
        "$ref": "#/$defs/RedFlag"
      },
      "title": "Red Flags B",
      "type": "array"
    },
    "run_id_a": {
      "title": "Run Id A",
      "type": "string"
    },
    "run_id_b": {
      "title": "Run Id B",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "why_winner_is_better": {
      "title": "Why Winner Is Better",
      "type": "string"
    },
    "winner": {
      "enum": [
        "A",
        "B",
        "tie"
      ],
      "title": "Winner",
      "type": "string"
    }
