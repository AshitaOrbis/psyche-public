{
  "$defs": {
    "SourceGrounding": {
      "description": "How well-grounded a source packet is in actual retrieved material.",
      "enum": [
        "high",
        "medium",
        "low",
        "none"
      ],
      "title": "SourceGrounding",
      "type": "string"
    }
  },
  "description": "Kit \u00a77. Ingested + structured public material for a public-inspired persona.\n\nGenerated by source_hunt.py (codex-researcher retrieval) followed by the\nkit \u00a77 ingestion prompt. Records grounding level so downstream analysis\ncan separate source-grounded results from background-knowledge fallback.\n\nUses extra=\"ignore\" \u2014 LLMs inevitably return extra fields, and this\nobject is write-once-by-LLM, not user-editable. Ignoring extras is\nsafer than rejecting them.",
  "properties": {
    "alias": {
      "title": "Alias",
      "type": "string"
    },
    "anchor_family": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Anchor Family"
    },
    "attitude_to_institutions": {
      "title": "Attitude To Institutions",
      "type": "string"
    },
    "attitude_to_speed_vs_caution": {
      "title": "Attitude To Speed Vs Caution",
      "type": "string"
    },
    "attitude_to_uncertainty": {
      "title": "Attitude To Uncertainty",
      "type": "string"
    },
    "broad_worldview_features": {
      "items": {
        "type": "string"
      },
      "title": "Broad Worldview Features",
      "type": "array"
    },
    "care_values": {
      "items": {
        "type": "string"
      },
      "title": "Care Values",
      "type": "array"
    },
    "caricature_risks": {
      "description": "At least 5 per kit \u00a77",
      "items": {
        "type": "string"
      },
      "title": "Caricature Risks",
      "type": "array"
    },
    "conflict_style": {
      "title": "Conflict Style",
      "type": "string"
    },
    "date_range": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date Range"
    },
    "decision_style": {
      "title": "Decision Style",
      "type": "string"
    },
    "do_not_infer": {
      "items": {
        "type": "string"
      },
      "title": "Do Not Infer",
      "type": "array"
    },
    "epistemic_style": {
      "title": "Epistemic Style",
      "type": "string"
    },
    "internal_public_anchor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Internal Public Anchor"
    },
    "likely_helpful_assistant_behavior": {
      "items": {
        "type": "string"
      },
      "title": "Likely Helpful Assistant Behavior",
      "type": "array"
    },
    "likely_unhelpful_assistant_behavior": {
      "items": {
        "type": "string"
      },
      "title": "Likely Unhelpful Assistant Behavior",
      "type": "array"
    },
    "low_confidence_hypotheses": {
      "items": {
        "type": "string"
      },
      "title": "Low Confidence Hypotheses",
      "type": "array"
    },
    "raw_sources": {
      "description": "[{url, excerpt, retrieved_at, source_type}, ...] \u2014 kept as audit trail; retrieved material only, never fabricated excerpts.",
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Raw Sources",
      "type": "array"
    },
    "recurring_tensions": {
      "items": {
        "type": "string"
      },
      "title": "Recurring Tensions",
      "type": "array"
    },
    "rhetorical_posture": {
      "title": "Rhetorical Posture",
      "type": "string"
    },
    "source_count": {
      "minimum": 0,
      "title": "Source Count",
      "type": "integer"
    },
    "source_grounding": {
      "$ref": "#/$defs/SourceGrounding"
    },
    "source_limitations": {
      "title": "Source Limitations",
      "type": "string"
    },
    "source_packet_id": {
      "title": "Source Packet Id",
      "type": "string"
    },
    "source_types": {
      "items": {
        "type": "string"
      },
      "title": "Source Types",
      "type": "array"
    },
    "status_or_power_themes": {
      "items": {
        "type": "string"
      },
      "title": "Status Or Power Themes",
      "type": "array"
    },
    "usable_persona_hypotheses": {
      "items": {
        "type": "string"
      },
      "title": "Usable Persona Hypotheses",
      "type": "array"
    }
  },
  "required": [
    "source_packet_id",
    "alias",
    "source_count",
    "source_grounding",
    "source_limitations",
    "rhetorical_posture",
    "epistemic_style",
    "decision_style",
    "conflict_style",
    "attitude_to_uncertainty",
    "attitude_to_institutions",
    "attitude_to_speed_vs_caution"
  ],
  "title": "SourcePacket",
  "type": "object"
}
